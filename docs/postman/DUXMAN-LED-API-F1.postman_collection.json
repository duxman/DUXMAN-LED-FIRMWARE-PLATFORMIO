    {
      "name": "01 - F2 Paridad home",
      "item": [
        {
          "name": "Aplicar estado completo",
          "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"power\": true,\n  \"brightness\": 180,\n  \"effect\": \"{{effect}}\",\n  \"sectionCount\": 4,\n  \"effectSpeed\": 60,\n  \"effectLevel\": 7,\n  \"effectTransitionMs\": 500,\n  \"effectTransitionStyle\": \"fade\",\n  \"primaryColors\": [\"#FF0000\", \"#00FF00\", \"#0000FF\"],\n  \"backgroundColor\": \"#000000\"\n}" }, "url": { "raw": "{{baseUrl}}/api/v1/state", "host": ["{{baseUrl}}"], "path": ["api", "v1", "state"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "const json = pm.response.json();", "pm.test('Mutation succeeded', function () { pm.expect(json.ok).to.eql(true); });", "pm.test('State response exists', function () { pm.expect(json.state).to.be.an('object'); });"] } }]
        },
        {
          "name": "Aplicar estado sin cambios",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"brightness\": 180,\n  \"effect\": \"{{effect}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/v1/state", "host": ["{{baseUrl}}"], "path": ["api", "v1", "state"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.test('Mutation envelope exists', function () { pm.expect(pm.response.json().ok).to.eql(true); });", "pm.test('updated is boolean', function () { pm.expect(pm.response.json().updated).to.be.a('boolean'); });"] } }]
        },
        {
          "name": "Aplicar paleta",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"palette\": \"{{palette}}\"\n}" }, "url": { "raw": "{{baseUrl}}/api/v1/palettes/apply", "host": ["{{baseUrl}}"], "path": ["api", "v1", "palettes", "apply"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.test('Mutation succeeded', function () { pm.expect(pm.response.json().ok).to.eql(true); });"] } }]
        },
        {
          "name": "Guardar efecto de arranque",
          "request": { "method": "POST", "header": [], "url": { "raw": "{{baseUrl}}/api/v1/effects/startup/save", "host": ["{{baseUrl}}"], "path": ["api", "v1", "effects", "startup", "save"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "pm.test('Mutation succeeded', function () { pm.expect(pm.response.json().ok).to.eql(true); });"] } }]
        },
        {
          "name": "Anadir estado a secuencia",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"durationSec\": 30\n}" }, "url": { "raw": "{{baseUrl}}/api/v1/effects/sequence/add", "host": ["{{baseUrl}}"], "path": ["api", "v1", "effects", "sequence", "add"] } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "const json = pm.response.json();", "pm.test('Mutation succeeded', function () { pm.expect(json.ok).to.eql(true); });", "if (json.id) pm.collectionVariables.set('sequenceEntryId', String(json.id));"] } }]
        },
        {
          "name": "Eliminar estado de secuencia",
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"id\": {{sequenceEntryId}}\n}" }, "url": { "raw": "{{baseUrl}}/api/v1/effects/sequence/delete", "host": ["{{baseUrl}}"], "path": ["api", "v1", "effects", "sequence", "delete"] } },
